# Copie para .env e ajuste. Nenhuma variavel e obrigatoria para rodar com o modelo local.

# Modelo de linguagem no formato provedor:nome
PERGUNTE_MODELO=ollama:qwen2.5:7b
# PERGUNTE_MODELO=anthropic:claude-haiku-5-5

# Onde o Ollama esta ouvindo
OLLAMA_HOST=http://localhost:11434

# So para o provedor anthropic (pip install -e ".[anthropic]")
# ANTHROPIC_API_KEY=
# Quantas perguntas da conversa vao para o modelo a cada chamada
# PERGUNTE_MAX_TURNOS=6

# Grava uma linha JSON por pergunta respondida (desligado por padrao)
# PERGUNTE_TRACE=trace.jsonl
